{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svedocs dev",
    "build": "svedocs build --no-og",
    "build:edge": "svedocs build --mode edge --no-og",
    "build:static": "svedocs build --mode static --no-og",
    "build:ssg": "svedocs ssg",
    "build:spa": "svedocs build --mode spa",
    "preview": "svedocs preview",
    "deploy": "pnpm check && pnpm check:ui && pnpm build:static && wrangler deploy",
    "deploy:dry-run": "pnpm build:static && wrangler deploy --dry-run",
    "check": "svedocs check",
    "check:ui": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "svedocs": "0.2.1",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "svedocs-cli": "0.2.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@12.3.4"
}
